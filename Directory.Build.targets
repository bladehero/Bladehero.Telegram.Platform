<Project>
  <!--
      Runs after the project body, so `IsPackable` set inside a .csproj is visible here.
      Ships the repo README and LICENSE inside every package.
    -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- A package's public API is documented: a missing XML comment fails its build. Tests and samples are exempt. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'false'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
</Project>
