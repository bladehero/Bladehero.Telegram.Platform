<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
      All dependencies resolve from nuget.org. `clear` drops any machine- or user-level
      sources (e.g. private GitHub Packages feeds) so restore is reproducible for anyone
      cloning the repo, and keeps central package management on a single source.
    -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
