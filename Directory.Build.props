<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Shared NuGet metadata. Individual packages only declare PackageId/Title/Description. -->
  <PropertyGroup>
    <Authors>bladehero</Authors>
    <Company>bladehero</Company>
    <Copyright>Copyright (c) Nikita Dermenzhi</Copyright>
    <PackageProjectUrl>https://github.com/bladehero/Bladehero.Telegram.Platform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bladehero/Bladehero.Telegram.Platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>telegram;telegram-bot;bot;commands;webhook;long-polling;aspnetcore;dependency-injection</PackageTags>
  </PropertyGroup>

  <!-- Source Link ships in the SDK; these switches are all that is needed for debuggable packages. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The packages ship together under one version, and some use each other's internals, so each depends on exactly the
    version of its siblings it was built with ([x.y.z]) rather than that version or later.
  -->
  <Target Name="PinProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="@(_ProjectReferencesWithVersions)"
        ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]"
      />
    </ItemGroup>
  </Target>
</Project>
