<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Bladehero.Telegram.Platform.Testing</PackageId>
    <Title>Bladehero.Telegram.Platform.Testing</Title>
    <Description>Component tests for Telegram bots built on Bladehero.Telegram.Platform: runs the bot's real long-polling or webhook hosting against an in-memory Bot API that answers and records every request, with test users who send messages and files and tap buttons — no Telegram needed.</Description>
  </PropertyGroup>

  <!-- Hosting for both modes: the generic host for long polling, and the bot's own ASP.NET Core app, run through
       WebApplicationFactory, for webhooks. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bladehero.Telegram.Platform.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bladehero.Telegram.Platform.Receiving\Bladehero.Telegram.Platform.Receiving.csproj" />
    <ProjectReference Include="..\Bladehero.Telegram.Platform\Bladehero.Telegram.Platform.csproj" />
  </ItemGroup>
</Project>
