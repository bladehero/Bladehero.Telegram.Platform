<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Bladehero.Telegram.Platform.Receiving</PackageId>
    <Title>Bladehero.Telegram.Platform.Receiving</Title>
    <Description>Command-style update handling for Telegram bots: ITelegramCommand, strongly typed per-update-type base commands, assembly scanning, a parallel command executor, multi-step conversations and a declarative command menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bladehero.Telegram.Platform.Receiving.Background" />
    <InternalsVisibleTo Include="Bladehero.Telegram.Platform.Receiving.Tests" />
    <InternalsVisibleTo Include="Bladehero.Telegram.Platform.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bladehero.Configuration.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bladehero.Telegram.Platform\Bladehero.Telegram.Platform.csproj" />
  </ItemGroup>
</Project>
