<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Bladehero.Telegram.Platform.History.EntityFrameworkCore</PackageId>
    <Title>Bladehero.Telegram.Platform.History.EntityFrameworkCore</Title>
    <Description>An Entity Framework Core store for the history of Telegram bots built on Bladehero.Telegram.Platform: every update and Bot API call, mapped into the app's own DbContext and written apart from its unit of work.</Description>
    <PackageTags>telegram;telegram-bot;bot;history;audit;entity-framework-core;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bladehero.Telegram.Platform.History.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bladehero.Telegram.Platform\Bladehero.Telegram.Platform.csproj" />
  </ItemGroup>
</Project>
