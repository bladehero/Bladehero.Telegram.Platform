<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <Version>9.0.0</Version>
        <Authors>bladehero</Authors>
        <PackageId>Telegram.DotNet.Platform.Receiving</PackageId>
        <RepositoryUrl>https://github.com/bladehero/Telegram.DotNet.Platform</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/bladehero/Telegram.DotNet.Platform</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageDescription>Telegram.DotNet.Platform.Receiving</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Configuration.Extensions" Version="9.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.8"/>
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.8"/>
        <PackageReference Include="Telegram.Bot" Version="22.7.2"/>
    </ItemGroup>

</Project>